[global]
font = JetBrains Mono NL 16
foreground = "#d8dee9"
background = "#070707"
frame_color = "#bf616a"

width = (250, 500)
height = (30, 250)
offset = "10x10"
origin = "top-center"

icon_path = "/usr/share/icons/default/index.theme:/usr/share/pixmaps"
 
[urgency_low]
timeout = 10
 
[urgency_normal]
timeout = 20
 
[urgency_critical]
timeout = 0
